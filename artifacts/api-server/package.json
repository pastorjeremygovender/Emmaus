{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && node --experimental-strip-types src/scripts/export-seed.ts && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:content": "node --experimental-strip-types src/scripts/seed-content.ts",
    "seed:demo": "node --experimental-strip-types src/scripts/seed-demo.ts",
    "repair:step-statuses": "node --experimental-strip-types src/scripts/repair-step-statuses.ts",
    "repair:progress-duplicates": "node --experimental-strip-types src/scripts/repair-progress-duplicates.ts",
    "backfill:knowledge-index": "node --experimental-strip-types src/scripts/backfill-knowledge-index.ts",
    "export:seed": "node --experimental-strip-types src/scripts/export-seed.ts",
    "checksum:content": "node --experimental-strip-types src/scripts/content-checksum.ts",
    "test:unit": "node --test --experimental-strip-types src/lib/__tests__/sermon-start-detector.test.ts src/emmaus/__tests__/system-instructions.test.ts src/lib/__tests__/sermon-companion-description.test.ts src/lib/__tests__/devotional-completion-pct.test.ts src/lib/__tests__/room-role-policy.test.ts src/test-utils/__tests__/test-auth-guard.test.ts && pnpm run test:emmaus-canonical && pnpm run test:share-image-style && pnpm run test:bible-import && pnpm run test:bible-import-api && pnpm run test:session-refresh && pnpm run test:auth-identity && pnpm run test:progress-isolation && pnpm run test:auth-recovery-status && pnpm run test:admin-account-source && pnpm run test:account-lifecycle",
    "test:emmaus-canonical": "node --test --import=tsx/esm src/emmaus/__tests__/intent-router.test.ts src/emmaus/__tests__/canonical-tools.test.ts",
    "test:share-image-style": "export NODE_ENV=test && node --test --import=tsx/esm src/routes/__tests__/share-image-style.test.ts",
    "test:bible-import": "export NODE_ENV=test && node --test --import=tsx/esm src/lib/__tests__/bible-bulk-import.test.ts src/lib/__tests__/bible-bulk-import-store.test.ts src/lib/__tests__/bible-bulk-import-db.test.ts",
    "test:session-refresh": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --import=tsx/esm src/lib/__tests__/oidc-session-refresh.test.ts",
    "test:auth-identity": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --import=tsx/esm src/routes/__tests__/auth-identity.test.ts",
    "test:progress-isolation": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --import=tsx/esm src/routes/__tests__/progress-identity-isolation.test.ts",
    "test:daily-rhythm-authority": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --import=tsx/esm src/routes/__tests__/daily-rhythm-authority.test.ts",
    "test:auth-recovery-status": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --import=tsx/esm src/routes/__tests__/auth-recovery-status.test.ts",
    "test:room-meeting": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --import=tsx/esm src/routes/__tests__/room-meeting-flow.test.ts",
    "test:bible-import-api": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --import=tsx/esm src/routes/__tests__/bible-study-import.test.ts",
    "test:admin-account-source": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --import=tsx/esm src/lib/__tests__/admin-account-source.test.ts",
    "test:account-lifecycle": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --import=tsx/esm src/lib/__tests__/account-lifecycle.test.ts src/lib/__tests__/supabase-delete-idempotency.test.ts",
    "test:integration": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --experimental-strip-types src/routes/__tests__/audio-route.test.ts src/routes/__tests__/archive-authz.test.ts src/routes/__tests__/next-steps.test.ts src/routes/__tests__/devotional-multi-series.test.ts src/routes/__tests__/devotional-position-tracking.test.ts src/routes/__tests__/hide-progress-regression.test.ts src/emmaus/__tests__/authz.test.ts src/emmaus/__tests__/streaming.test.ts src/emmaus/__tests__/verified-auth.test.ts src/routes/__tests__/implicit-absence-flag.test.ts src/routes/__tests__/collection-completion-persistence.test.ts && pnpm run test:sermon-action-parity",
    "test:sermon-action-parity": "export NODE_ENV=test && export ALLOW_TEST_AUTH_HARNESS=1 && node --test --import=tsx/esm src/emmaus/__tests__/sermon-action-parity.test.ts",
    "test:integrity": "node --test --import=tsx/esm src/lib/__tests__/startup-integrity.test.ts && node --test --import=tsx/esm src/lib/__tests__/sermon-retrieval.test.ts && node --test --import=tsx/esm src/lib/__tests__/sermon-knowledge-index.test.ts",
    "test": "pnpm run test:unit && pnpm run test:integration"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@google-cloud/storage": "^7.21.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^11.0.0",
    "livekit-server-sdk": "^2.17.0",
    "openai": "^4.100.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.19.2"
  }
}
