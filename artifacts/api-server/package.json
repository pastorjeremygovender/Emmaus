{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:content": "node --experimental-strip-types src/scripts/seed-content.ts",
    "seed:demo": "node --experimental-strip-types src/scripts/seed-demo.ts",
    "repair:step-statuses": "node --experimental-strip-types src/scripts/repair-step-statuses.ts",
    "repair:progress-duplicates": "node --experimental-strip-types src/scripts/repair-progress-duplicates.ts",
    "export:seed": "node --experimental-strip-types src/scripts/export-seed.ts",
    "checksum:content": "node --experimental-strip-types src/scripts/content-checksum.ts",
    "test:unit": "node --test --experimental-strip-types src/lib/__tests__/sermon-start-detector.test.ts src/emmaus/__tests__/system-instructions.test.ts src/lib/__tests__/sermon-companion-description.test.ts",
    "test:integration": "node --test --experimental-strip-types src/routes/__tests__/audio-route.test.ts src/routes/__tests__/next-steps.test.ts src/routes/__tests__/devotional-multi-series.test.ts src/routes/__tests__/hide-progress-regression.test.ts src/emmaus/__tests__/authz.test.ts src/emmaus/__tests__/streaming.test.ts",
    "test:integrity": "node --test --import=tsx/esm src/lib/__tests__/startup-integrity.test.ts",
    "test": "pnpm run test:unit && pnpm run test:integration"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@google-cloud/storage": "^7.21.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^11.0.0",
    "openai": "^4.100.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.19.2"
  }
}
