modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "data-safety: content integrity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "emmaus-member-flow-regressions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Emmaus APK download (temporary)"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Jarvis temporary preview"

[[workflows.workflow]]
name = "data-safety: content integrity"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/project-emmaus run build && pnpm --filter @workspace/api-server run export:seed && pnpm --filter @workspace/api-server run checksum:content > /tmp/pre-deploy-checksum.json && pnpm --filter @workspace/api-server run test:integrity"

[[workflows.workflow]]
name = "emmaus-member-flow-regressions"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/project-emmaus exec vitest run --config vitest.config.ts src/lib/__tests__/startup-routing.test.ts src/lib/__tests__/daily-launch-regression.test.ts src/pages/__tests__/Welcome.daily-open.test.tsx src/pages/__tests__/ExploreJourneys.discovery-start.test.tsx src/pages/__tests__/Journeys.discovery-actions.test.tsx && pnpm --filter @workspace/project-emmaus run build"

[[workflows.workflow]]
name = "Emmaus APK download (temporary)"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3000 node /tmp/emmaus-apk-download-server.mjs"
waitForPort = 3000

[[workflows.workflow]]
name = "Jarvis temporary preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /tmp/emmaus-codex-jarvis-7d77a50/artifacts/api-server && APP_ENV=development NODE_ENV=development PORT=3000 pnpm exec tsx ../project-emmaus/.jarvis-preview-server.mjs"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
EMMAUS_DEEP_MODEL = "gpt-5"
EMMAUS_FAST_MODEL = "gpt-4o"
VAPID_SUBJECT = "https://emmaus.co.za"

[userenv.production]
EMMAUS_PUBLIC_ORIGIN = "https://emmaus.co.za"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 3000
externalPort = 3000
